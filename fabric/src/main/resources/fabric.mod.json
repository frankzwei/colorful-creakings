{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}+${minecraft_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [],
    "contact": {
        "homepage": "${homepage}",
        "issues": "https://github.com/${sources}/issues",
        "sources": "https://github.com/${sources}"
    },
    "accessWidener": "colorfulcreakings.accesswidener",
    "license": "${mod_license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "me.ultrusmods.colorfulcreakings.ColorfulCreakingsModFabric"
        ],
        "client": [
            "me.ultrusmods.colorfulcreakings.ColorfulCreakingsClientFabric"
        ],
        "fabric-datagen": [
            "me.ultrusmods.colorfulcreakings.datagen.ColorfulCreakingsDataGenerator"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${fabric_loader_range}",
        "fabric-api": "*",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${java_version}"
    }
}